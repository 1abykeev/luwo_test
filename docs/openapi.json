{
  "openapi": "3.1.0",
  "info": {
    "title": "Luwo list-support agent",
    "description": "\nAI support agent for Luwo: helps teachers and school administrators keep lists of students,\nteachers and classes up to date through a chat.\n\n**Try it:** `POST /auth/login` with a demo account, press **Authorize** and paste the token.\n",
    "version": "0.2.0"
  },
  "paths": {
    "/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Log in with email and password",
        "description": "Returns a JWT. Send it as `Authorization: Bearer <token>` on every other request. Demo accounts and their password are listed in the README.",
        "operationId": "login_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "401": {
            "description": "Wrong email or password",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Who am I?",
        "description": "The role, school and classes as the server sees them (loaded from the database, never from the token).",
        "operationId": "me_auth_me_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/chat": {
      "post": {
        "tags": [
          "chat"
        ],
        "summary": "Send a message to the agent",
        "description": "The agent reads the message with the conversation so far, looks things up, and answers. Changes are never made here: the agent proposes them and the response carries a `confirmation` card. The change happens only after the user presses Confirm (`POST /chat/confirm`) or writes a clear yes in a later message.\n\n**Cards (`blocks`)** the app draws under the answer. Every block has a `type`:\n\n| type | when | main fields |\n|---|---|---|\n| `class_roster` | a class list | `class`, `school`, `teachers` (null = hidden from this user), `students[{id, full_name, status}]` |\n| `class_overview` | classes of a school | `classes[{name, school, active_students, teachers}]` |\n| `teacher_list` | teachers | `teachers[{id, full_name, school, classes}]` |\n| `school_list` | schools (superadmin) | `schools[{id, name}]` |\n| `student_list` | search results, to pick from | `students[{id, full_name, class, school, status}]` |\n| `student_card` | one student | `student`, `history[{action, date, from_class, to_class}]` |\n| `duplicates` | namesakes | `groups[{name, students}]` |\n| `investigation` | \"where did the student go\" | `findings[{student_id, full_name, state, current_class, history}]` |\n| `confirmation` | a change waits for the user | `token`, `summary`, `details`, `warnings`, `expires_at` → show Confirm / Cancel buttons that call `POST /chat/confirm` |\n| `result` | a change was made | `status` (`done` / `already_done`), `result` |\n| `banner` | an error or notice | `level` (`error` / `info`), `message`, `code` |",
        "operationId": "chat_chat_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Unknown conversation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/chat/confirm": {
      "post": {
        "tags": [
          "chat"
        ],
        "summary": "Press Confirm or Cancel on a confirmation card",
        "description": "The backend carries out (or cancels) the pending change first; the agent then puts the real result into words. Pressing twice is safe: the second press reports `already_done` and changes nothing. Only the person who got the card can use its token.",
        "operationId": "confirm_chat_confirm_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConfirmRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/chat/history": {
      "get": {
        "tags": [
          "chat"
        ],
        "summary": "Messages of a conversation",
        "description": "What the app shows when it opens: typed messages and answers with their cards. Without `conversation_id` it returns the user's most recent conversation (empty if none).",
        "operationId": "history_chat_history_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "conversation_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,64}$"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Conversation Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HistoryResponse"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Is the server up?",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChatMeta": {
        "properties": {
          "request_type": {
            "type": "string",
            "title": "Request Type",
            "description": "add, remove, transfer, show, search, missing_student, duplicate, off_topic, ..."
          },
          "outcome": {
            "type": "string",
            "title": "Outcome",
            "description": "resolved, permission_denied, needs_clarification, out_of_scope or error"
          },
          "llm_calls": {
            "type": "integer",
            "title": "Llm Calls"
          },
          "input_tokens": {
            "type": "integer",
            "title": "Input Tokens"
          },
          "output_tokens": {
            "type": "integer",
            "title": "Output Tokens"
          },
          "cached_tokens": {
            "type": "integer",
            "title": "Cached Tokens"
          },
          "duration_ms": {
            "type": "integer",
            "title": "Duration Ms"
          }
        },
        "type": "object",
        "required": [
          "request_type",
          "outcome",
          "llm_calls",
          "input_tokens",
          "output_tokens",
          "cached_tokens",
          "duration_ms"
        ],
        "title": "ChatMeta"
      },
      "ChatRequest": {
        "properties": {
          "message": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Message",
            "description": "What the user typed"
          },
          "conversation_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,64}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Conversation Id",
            "description": "Omit to start a new conversation; send the id from the previous response to continue it"
          }
        },
        "type": "object",
        "required": [
          "message"
        ],
        "title": "ChatRequest",
        "example": {
          "message": "Переведите Алину из 3А в 3Б"
        }
      },
      "ChatResponse": {
        "properties": {
          "conversation_id": {
            "type": "string",
            "title": "Conversation Id"
          },
          "text": {
            "type": "string",
            "title": "Text",
            "description": "The agent's answer, in the user's language"
          },
          "blocks": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Blocks",
            "description": "Cards for the app to draw under the text. Each has a `type`; see the list in the description of POST /chat."
          },
          "meta": {
            "$ref": "#/components/schemas/ChatMeta"
          }
        },
        "type": "object",
        "required": [
          "conversation_id",
          "text",
          "blocks",
          "meta"
        ],
        "title": "ChatResponse"
      },
      "ConfirmRequest": {
        "properties": {
          "conversation_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "title": "Conversation Id"
          },
          "token": {
            "type": "string",
            "maxLength": 64,
            "title": "Token",
            "description": "The token on the confirmation card"
          },
          "approve": {
            "type": "boolean",
            "title": "Approve",
            "description": "true = Confirm button, false = Cancel button",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "conversation_id",
          "token"
        ],
        "title": "ConfirmRequest",
        "example": {
          "approve": true,
          "conversation_id": "c_0123456789abcdef",
          "token": "…"
        }
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code",
            "description": "authentication_failed, permission_denied, not_found, invalid_request, conflict"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "details": {
            "additionalProperties": true,
            "type": "object",
            "title": "Details",
            "default": {}
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HistoryMessage": {
        "properties": {
          "role": {
            "type": "string",
            "title": "Role",
            "description": "user or assistant"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "blocks": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Blocks"
          },
          "at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "At"
          }
        },
        "type": "object",
        "required": [
          "role",
          "text",
          "blocks",
          "at"
        ],
        "title": "HistoryMessage"
      },
      "HistoryResponse": {
        "properties": {
          "conversation_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Conversation Id",
            "description": "None when the user has no conversation yet"
          },
          "messages": {
            "items": {
              "$ref": "#/components/schemas/HistoryMessage"
            },
            "type": "array",
            "title": "Messages"
          }
        },
        "type": "object",
        "required": [
          "conversation_id",
          "messages"
        ],
        "title": "HistoryResponse"
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 200,
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest",
        "example": {
          "email": "aigul@luwo.test",
          "password": "demo1234"
        }
      },
      "ProfileResponse": {
        "properties": {
          "user_id": {
            "type": "integer",
            "title": "User Id"
          },
          "full_name": {
            "type": "string",
            "title": "Full Name"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "school_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "School Name",
            "description": "None for the superadmin, who is not tied to a school"
          },
          "class_names": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Class Names",
            "description": "Classes a teacher leads; empty for admins"
          }
        },
        "type": "object",
        "required": [
          "user_id",
          "full_name",
          "role",
          "school_name",
          "class_names"
        ],
        "title": "ProfileResponse"
      },
      "Role": {
        "type": "string",
        "enum": [
          "teacher",
          "school_admin",
          "superadmin"
        ],
        "title": "Role"
      },
      "TokenResponse": {
        "properties": {
          "access_token": {
            "type": "string",
            "title": "Access Token"
          },
          "token_type": {
            "type": "string",
            "title": "Token Type",
            "default": "bearer"
          },
          "user": {
            "$ref": "#/components/schemas/ProfileResponse"
          }
        },
        "type": "object",
        "required": [
          "access_token",
          "user"
        ],
        "title": "TokenResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "description": "Token from POST /auth/login",
        "scheme": "bearer"
      }
    }
  },
  "tags": [
    {
      "name": "auth",
      "description": "Log in and see who the server thinks you are."
    },
    {
      "name": "chat",
      "description": "Talk to the agent. Everything the mobile app does goes through here."
    },
    {
      "name": "system",
      "description": "Health checks."
    }
  ]
}
# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# "postgres" (real database) or "memory" (demo data, no database needed)
DATA_SOURCE=postgres
DATABASE_URL=postgresql+asyncpg://luwo:luwo@localhost:5433/luwo

# "claude" for the real model, "fake" for scripted responses (tests, load tests)
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
# Thinking mode sent to Claude ("disabled" for Haiku 5.5; empty to omit the parameter)
LLM_THINKING=disabled
# Longest a single chat request may take, all model calls together
AGENT_TIMEOUT_SECONDS=90

# "dev" for local work. Any other value requires a real JWT_SECRET (32+ characters), e.g. from: openssl rand -hex 32
APP_ENV=dev
JWT_SECRET=dev-only-secret-change-me-before-deploying-0000
JWT_EXPIRE_MINUTES=480

# Browser origins allowed to call the API (only the Expo web preview needs this)
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Logs: INFO/DEBUG/..., JSON lines (true) or readable lines (false), and whether user messages are logged
LOG_LEVEL=INFO
LOG_JSON=true
# Message text and tool arguments in the logs: on by default in dev, off elsewhere unless you set true
LOG_USER_TEXT=true

# Protect /metrics with a bearer token (leave empty for local use)
METRICS_TOKEN=

# PostgreSQL connection pool (connections kept open / extra allowed in a burst)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10

# Only with LLM_PROVIDER=fake (load tests): seconds the scripted model waits before each answer
FAKE_LLM_DELAY=0

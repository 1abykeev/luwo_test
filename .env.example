# Copy to .env and fill in. .env is git-ignored; never commit real keys.

DATABASE_URL=postgresql+asyncpg://luwo:luwo@localhost:5433/luwo

# "claude" for the real model, "fake" for scripted responses (tests, load tests)
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5

# Change this in any real deployment
JWT_SECRET=dev-only-change-me
JWT_EXPIRE_MINUTES=480
